{
  "name": "app-requests",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "description": "Civitai App (page app) \u2014 a community voting board for new app/feature requests, built on the cross-user shared storage platform (useSharedStorage). No Buzz, no generation.",
  "license": "MIT",
  "scripts": {
    "postinstall": "node -e \"console.log('\\n\u2713 Installed. Next: npm run dev:harness   (preview \u2014 mock host, cross-user shared store)\\n  test: npm run test   \u00b7   build: npm run build\\n')\"",
    "dev": "vite",
    "dev:harness": "VITE_DEV_HARNESS=true vite --host localhost --port 5187",
    "dev:tunnel": "CIVITAI_DEV_TUNNEL_HMR=1 vite --host localhost --port 5187 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@civitai/app-sdk": "^0.26.0",
    "@civitai/blocks-react": "^0.35.2",
    "@civitai/theme": "^0.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
