# Loaded by `vite dev` / `npm run dev:harness` / `npm run dev:tunnel`. The
# harness fires BLOCK_INIT from window.location.origin (the dev server origin
# pinned in vite.config.ts, localhost:5187); `dev:tunnel` embeds this dev server
# inside the REAL host at https://civitai.com/apps/dev/<id>, so civitai.com is
# also allowed here. DEV-ONLY — the production allowlist lives in .env.production.
VITE_BLOCK_ALLOWED_PARENT_ORIGINS=http://localhost:5187,https://civitai.com
